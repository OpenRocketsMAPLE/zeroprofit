# ZeroProfit — environment template
# ---------------------------------------------------------------------------
# This application is a self-contained local demo. It runs 100% credential-free:
# every production integration (SSO, Netlify, DNS, email, forums, ads) has an
# honest "local demo" state in the UI and an adapter contract in `src/lib/adapters.ts`.
#
# Replace values below ONLY when wiring a real deployment. Never commit real
# secrets. All keys here are placeholders.
# ---------------------------------------------------------------------------

# Public branding (used in meta tags / UI)
VITE_APP_NAME=ZeroProfit

# Authentication mode (this SPA has no backend; production auth is an SSO
# redirect handled by the API layer, not by Vite env vars).
# AUTH_MODE=mock
# SSO_ISSUER=https://accounts.openrockets.com
# SSO_CLIENT_ID=change-me

# Netlify OAuth (production credential-dependent integration)
# VITE_NETLIFY_CLIENT_ID=change-me
# VITE_NETLIFY_CLIENT_SECRET=change-me
# VITE_NETLIFY_REDIRECT_URI=https://app.zeroprofit.org/org/deploy/callback

# Widget host (production)
# VITE_WIDGETS_BASE_URL=https://widgets.zeroprofit.org
